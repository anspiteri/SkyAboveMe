{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self), camera=(), microphone=()"
        }
      ]
    }
  ],
  "functions": {
    "api/**/*.[jt]s": {
      "runtime": "vercel-deno@3.2.0",
      "maxDuration": 10
    }
  }
}
