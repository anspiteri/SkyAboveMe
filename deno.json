{
  "nodeModulesDir": true,
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable", "deno.ns"],
    "types": ["vite/client"]
  },
  "tasks": {
    "dev": "deno task dev:api & deno task dev:vite",
    "dev:vite": "deno run -A npm:vite",
    "dev:api": "deno run --allow-net scripts/dev-api.ts",
    "dev:mock": "deno task dev:api:mock & deno task dev:vite",
    "dev:api:mock": "deno run --allow-net scripts/dev-api-mock.ts",
    "build": "deno run -A npm:vite build",
    "preview": "deno run -A npm:vite preview",
    "typecheck": "deno check src api",
    "test": "deno test --allow-read --allow-env --allow-net"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "satellite.js": "npm:satellite.js@^7.1.0",
    "typescript": "npm:typescript@~6.0.3",
    "vite": "npm:vite@^8.2.2"
  }
}
