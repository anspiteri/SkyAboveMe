{
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable", "deno.ns", "deno.unstable"],
    "types": ["vite/client"]
  },
  "tasks": {
    "dev": "deno task dev:api & deno task dev:vite",
    "dev:vite": "deno run -A npm:vite",
    "dev:api": "deno run --allow-net scripts/dev-api.ts",
    "dev:mock": "deno task dev:api:mock & deno task dev:vite",
    "dev:api:mock": "deno run --allow-net scripts/dev-api-mock.ts",
    "build": "deno run -A npm:vite build",
    "serve": "deno run --allow-net --allow-read main.ts",
    "typecheck": "deno check src api main.ts",
    "test": "deno test --allow-read --allow-env --allow-net",
    "test:live": "deno test --allow-read --allow-env --allow-net tests/api/satellites.live.ts",
    "check:celestrak": "deno run --allow-net scripts/check-celestrak.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/http/file-server": "jsr:@std/http@^1.1.3/file-server",
    "satellite.js": "npm:satellite.js@^7.1.0",
    "vite": "npm:vite@^8.2.2"
  },
  "deploy": {
    "build": "deno task build",
    "runtime": {
      "type": "dynamic",
      "entrypoint": "./main.ts"
    }
  }
}
